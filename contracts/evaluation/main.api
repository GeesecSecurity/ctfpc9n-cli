syntax = "v1"

type AIAccount {
 Id string `json:"id"`
 Name string `json:"name"`
 Disabled bool `json:"disabled"`
 ExpiresAt int64 `json:"expiresAt"`
 CreatedAt int64 `json:"createdAt"`
}

type AIDeleteAccountResult {
 Deleted bool `json:"deleted"`
}

type AICredential {
 Account AIAccount `json:"account"`
 Token string `json:"token,omitempty"`
}

type AIAccountList {
 Items []AIAccount `json:"items"`
}

type AIModel {
 Provider string `json:"provider"`
 Name string `json:"name"`
 Version string `json:"version"`
}

type AITokens {
 Input *int64 `json:"input,optional,omitempty"`
 Output *int64 `json:"output,optional,omitempty"`
 Cached *int64 `json:"cached,optional,omitempty"`
 Reasoning *int64 `json:"reasoning,optional,omitempty"`
 Total *int64 `json:"total,optional,omitempty"`
}

type AIDeclaredScore {
 Score *float64 `json:"score"`
 MaxScore *float64 `json:"maxScore"`
 ElapsedSeconds *int64 `json:"elapsedSeconds"`
}

type AIQuestionScore {
 Score *float64 `json:"score"`
 MaxScore *float64 `json:"maxScore"`
}
type AIQuestionDetail {
 Attack *AIQuestionScore `json:"attack,optional,omitempty"`
 Repair *AIQuestionScore `json:"repair,optional,omitempty"`
 ChallengeId string `json:"challengeId"`
 Notes string `json:"notes,optional"`
 Tokens *AITokens `json:"tokens,optional,omitempty"`
}

type AIMetadata {
 AttackElapsedSeconds *int64 `json:"attackElapsedSeconds,optional,omitempty"`
 RepairElapsedSeconds *int64 `json:"repairElapsedSeconds,optional,omitempty"`
 Models []AIModel `json:"models,optional,omitempty"`
 AgentName string `json:"agentName,optional,omitempty"`
 AgentVersion string `json:"agentVersion,optional,omitempty"`
 ToolConfig string `json:"toolConfig,optional,omitempty"`
 HumanAssisted *bool `json:"humanAssisted,optional,omitempty"`
 Notes string `json:"notes,optional,omitempty"`
 Tokens *AITokens `json:"tokens,optional,omitempty"`
 Attack *AIDeclaredScore `json:"attack,optional,omitempty"`
 Repair *AIDeclaredScore `json:"repair,optional,omitempty"`
 QuestionDetails []AIQuestionDetail `json:"questionDetails,optional,omitempty"`
}

type AILimits {
 MaxActiveRuns int `json:"maxActiveRuns"`
 MaxDynamicInstances int `json:"maxDynamicInstances"`
 QuestionTimeoutSeconds int64 `json:"questionTimeoutSeconds"`
 RunTimeoutSeconds int64 `json:"runTimeoutSeconds"`
}

type AIBenchmark {
 Source string `json:"source,optional,omitempty"`
 DefaultKey string `json:"defaultKey,optional,omitempty"`
 VersionStatus string `json:"versionStatus,optional,omitempty"`
 DirectionCounts map[string]int `json:"directionCounts,optional,omitempty"`
 Id string `json:"id"`
 BankId string `json:"bankId"`
 Name string `json:"name"`
 Version string `json:"version"`
 QuestionCount int `json:"questionCount"`
 RepairQuestionCount int `json:"repairQuestionCount"`
 RuleVersion string `json:"ruleVersion"`
 Limits AILimits `json:"limits"`
 Fixture bool `json:"fixture"`
}

type AIBenchmarkList {
 AutomaticRankingAvailable bool `json:"automaticRankingAvailable,optional"`
 Items []AIBenchmark `json:"items"`
}

type AIRun {
 Visibility string `json:"visibility,optional,omitempty"`
 Id string `json:"id"`
 AccountId string `json:"accountId"`
 AccountName string `json:"accountName"`
 BenchmarkId string `json:"benchmarkId"`
 BenchmarkName string `json:"benchmarkName"`
 Status string `json:"status"`
 CreatedAt int64 `json:"createdAt"`
 StartedAt int64 `json:"startedAt"`
 FinishedAt int64 `json:"finishedAt"`
 Metadata AIMetadata `json:"metadata"`
 AttackScore float64 `json:"attackScore"`
 RepairScore *float64 `json:"repairScore,optional,omitempty"`
 ElapsedSeconds int64 `json:"elapsedSeconds"`
 InfrastructureError bool `json:"infrastructureError"`
}

type AIRunList {
 Items []AIRun `json:"items"`
}

type AIAttachment {
 Id string `json:"id"`
 Name string `json:"name"`
 Size int64 `json:"size"`
}

type AIChallenge {
 Tags []string `json:"tags,optional,omitempty"`
 Id string `json:"id"`
 Name string `json:"name"`
 Category string `json:"category"`
 Kind string `json:"kind"`
 Description string `json:"description"`
 Attachments []AIAttachment `json:"attachments"`
 AttackSolved bool `json:"attackSolved"`
 RepairPassed bool `json:"repairPassed"`
 Attempts int `json:"attempts"`
 RepairAttempts int `json:"repairAttempts"`
 FirstRepairSuccessAt *int64 `json:"firstRepairSuccessAt,optional,omitempty"`
 FirstSuccessAt *int64 `json:"firstSuccessAt,optional,omitempty"`
 ProvisioningSeconds int64 `json:"provisioningSeconds"`
}

type AIChallengeList {
 Total int `json:"total"`
 Page int `json:"page"`
 PageSize int `json:"pageSize"`
 Items []AIChallenge `json:"items"`
}

type AIPublication {
 Automatic bool `json:"automatic,optional,omitempty"`
 Status string `json:"status,optional,omitempty"`
 Hidden bool `json:"hidden,optional,omitempty"`
 DirectionOnly bool `json:"directionOnly,optional,omitempty"`
 Id string `json:"id"`
 RunId string `json:"runId"`
 AccountId string `json:"accountId"`
 AccountName string `json:"accountName"`
 BenchmarkId string `json:"benchmarkId"`
 Board string `json:"board"`
 Track string `json:"track"`
 Score float64 `json:"score"`
 ElapsedSeconds int64 `json:"elapsedSeconds"`
 PublishedAt int64 `json:"publishedAt"`
 Metadata AIMetadata `json:"metadata"`
}

type AIRankRow {
 Automatic bool `json:"automatic,optional,omitempty"`
 Status string `json:"status,optional,omitempty"`
 Direction string `json:"direction,optional,omitempty"`
 QuestionCount int `json:"questionCount"`
 SolvedCount int `json:"solvedCount"`
 ScoreSource string `json:"scoreSource,optional,omitempty"`
 ElapsedSource string `json:"elapsedSource,optional,omitempty"`
 Id string `json:"id"`
 RunId string `json:"runId"`
 AccountId string `json:"accountId"`
 AccountName string `json:"accountName"`
 BenchmarkId string `json:"benchmarkId"`
 Board string `json:"board"`
 Track string `json:"track"`
 Score float64 `json:"score"`
 ElapsedSeconds int64 `json:"elapsedSeconds"`
 PublishedAt int64 `json:"publishedAt"`
 Metadata AIMetadata `json:"metadata"`
 Rank int `json:"rank"`
}

type AILeaderboard {
 Stage string `json:"stage"`
 Applicable *bool `json:"applicable,optional,omitempty"`
 QuestionCount int `json:"questionCount"`
 Items []AIRankRow `json:"items"`
 Total int `json:"total"`
 Rule string `json:"rule"`
 TrustNotice string `json:"trustNotice"`
}

type AIReport {
 ChallengeTotal int `json:"challengeTotal"`
 Page int `json:"page"`
 PageSize int `json:"pageSize"`
 ContentRestricted bool `json:"contentRestricted"`
 Benchmark AIBenchmark `json:"benchmark"`
 Run AIRun `json:"run"`
 Challenges []AIChallenge `json:"challenges"`
 Publications []AIPublication `json:"publications"`
 TrustNotice string `json:"trustNotice"`
}

type AIFlagResult {
 Correct bool `json:"correct"`
 AlreadySolved bool `json:"alreadySolved"`
}

type AIRuntime {
 Id string `json:"id"`
 Status string `json:"status"`
 Endpoint string `json:"endpoint,optional,omitempty"`
 ExpiresAt int64 `json:"expiresAt"`
 ProvisioningSeconds int64 `json:"provisioningSeconds"`
}

type AIJob {
 Id string `json:"id"`
 Status string `json:"status"`
 Kind string `json:"kind"`
 ErrorCode string `json:"errorCode,optional,omitempty"`
}

type AIPatchResult {
 PatchId string `json:"patchId"`
}

type AIWithdrawResult {
 Withdrawn bool `json:"withdrawn"`
}

type AIModerateResult {
 Hidden bool `json:"hidden"`
}

type AISession {
 Account AIAccount `json:"account"`
}

type AIMaterial {
 Id string `json:"id"`
 Name string `json:"name"`
 Content string `json:"content"`
}

type AIIdentityWrite {
 RequestId string `json:"requestId"`
 AccountId string `json:"accountId,optional"`
 Name string `json:"name,optional"`
}

type AIWrite {
 Visibility string `json:"visibility,optional"`
 CandidateId string `json:"candidateId,optional"`
 QuestionDetails []AIQuestionDetail `json:"questionDetails,optional"`
 Page int `json:"page,optional"`
 PageSize int `json:"pageSize,optional"`
 RequestId string `json:"requestId"`
 AccountId string `json:"accountId,optional"`
 BenchmarkId string `json:"benchmarkId,optional"`
 RunId string `json:"runId,optional"`
 ChallengeId string `json:"challengeId,optional"`
 PublicationId string `json:"publicationId,optional"`
 PatchId string `json:"patchId,optional"`
 Flag string `json:"flag,optional"`
 Board string `json:"board,optional"`
 Track string `json:"track,optional"`
 Reason string `json:"reason,optional"`
 FileName string `json:"fileName,optional"`
 ContentBase64 string `json:"contentBase64,optional"`
 Metadata *AIMetadata `json:"metadata,optional"`
}

type AIImport {
 RequestId string `json:"requestId"`
 SnapshotJson string `json:"snapshotJson"`
}

type AIQuery {
 Stage string `form:"stage,optional"`
 Direction string `form:"direction,optional"`
 CandidateId string `form:"candidateId,optional"`
 RunId string `form:"runId,optional"`
 ChallengeId string `form:"challengeId,optional"`
 AttachmentId string `form:"attachmentId,optional"`
 PublicationId string `form:"publicationId,optional"`
 BenchmarkId string `form:"benchmarkId,optional"`
 Board string `form:"board,optional"`
 Track string `form:"track,optional"`
 Page int `form:"page,optional"`
 PageSize int `form:"pageSize,optional"`
}

type AIDefaultEntry {
 Key string `json:"key"`
 Name string `json:"name"`
 Direction string `json:"direction"`
 BenchmarkId string `json:"benchmarkId"`
 Version string `json:"version"`
 QuestionCount int `json:"questionCount"`
 Status string `json:"status"`
}
type AIDefaultCatalog { Items []AIDefaultEntry `json:"items"` }
type AICandidateTask {
 Id string `json:"id"`
 Status string `json:"status"`
 CreatedAt int64 `json:"createdAt"`
 ErrorCode string `json:"errorCode"`
}
type AICandidateDiff {
 ProblemId string `json:"problemId"`
 Name string `json:"name"`
 Direction string `json:"direction"`
 Change string `json:"change"`
 Reason string `json:"reason"`
}
type AICandidatePreview {
 Items []AICandidateDiff `json:"items"`
 Total int64 `json:"total"`
}

@server(
 group: aiAccounts
 prefix: /ai/accounts
 jwt: Auth
 middleware: CheckRole,AIEvaluationFeature
)
service api {
 @handler aiListAccounts
 get /list returns (AIAccountList)

 @handler aiCreateAccount
 post /create (AIIdentityWrite) returns (AICredential)

 @handler aiRenameAccount
 post /rename (AIIdentityWrite) returns (AIAccount)

 @handler aiDisableAccount
 post /disable (AIIdentityWrite) returns (AIAccount)

 @handler aiDeleteAccount
 post /delete (AIIdentityWrite) returns (AIDeleteAccountResult)

 @handler aiRotateCredential
 post /rotate (AIIdentityWrite) returns (AICredential)

}

@server(
 group: aiEvaluations
 prefix: /ai/evaluations
 jwt: Auth
 middleware: CheckRole,AIEvaluationFeature
)
service api {
 @handler aiHumanChallenges
 get /challenges (AIQuery) returns (AIChallengeList)
 @handler aiQuestionScores
 post /question-scores (AIWrite) returns (AIReport)
 @handler aiListBenchmarks
 get /benchmarks returns (AIBenchmarkList)

 @handler aiListRuns
 get /list returns (AIRunList)

 @handler aiGetReport
 get /report (AIQuery) returns (AIReport)

 @handler aiCreateRun
 post /create (AIWrite) returns (AIRun)

 @handler aiRerun
 post /rerun (AIWrite) returns (AIRun)

 @handler aiCancelRun
 post /cancel (AIWrite) returns (AIRun)

 @handler aiUpdateMetadata
 post /self-report (AIWrite) returns (AIReport)

 @handler aiPublish
 post /publish (AIWrite) returns (AIPublication)

 @handler aiWithdraw
 post /withdraw (AIWrite) returns (AIWithdrawResult)

}

@server(
 maxBytes: 75000000
 group: aiEvaluationAdmin
 prefix: /ai/evaluations
 jwt: Auth
 middleware: CheckRole,AdminOnly,AIEvaluationFeature
)
service api {
 @handler aiDefaultsRefresh
 post /defaults/refresh (AIWrite) returns (AICandidateTask)
 @handler aiDefaultsStatus
 get /defaults/status (AIQuery) returns (AICandidateTask)
 @handler aiDefaultsPreview
 get /defaults/preview (AIQuery) returns (AICandidatePreview)
 @handler aiDefaultsPublish
 post /defaults/publish (AIWrite) returns (AIDefaultCatalog)
 @handler aiImportBenchmark
 post /import (AIImport) returns (AIBenchmark)

 @handler aiModeratePublication
 post /moderate (AIWrite) returns (AIModerateResult)

}

@server(
 group: aiEvaluationPublic
 prefix: /ai/public
 middleware: AIEvaluationFeature
)
service api {
 @handler aiPublicDefaults
 get /defaults returns (AIDefaultCatalog)
 @handler aiPublicBenchmarks
 get /benchmarks returns (AIBenchmarkList)

 @handler aiPublicLeaderboard
 get /leaderboard (AIQuery) returns (AILeaderboard)

 @handler aiPublicReport
 get /report (AIQuery) returns (AIReport)

}

@server(
 maxBytes: 15000000
 group: aiAgent
 prefix: /evaluation/agent/v1
 middleware: AIAgentAuth
)
service api {
 @handler aiAgentSession
 get /session returns (AISession)

 @handler aiAgentRuns
 get /runs returns (AIRunList)

 @handler aiAgentChallenges
 get /challenges (AIQuery) returns (AIChallengeList)

 @handler aiAgentChallenge
 get /challenge (AIQuery) returns (AIChallenge)

 @handler aiDownloadAttachment
 get /attachment (AIQuery) returns (AIMaterial)

 @handler aiAgentRuntime
 get /runtime (AIQuery) returns (AIRuntime)

 @handler aiAgentPatchStatus
 get /patch/status (AIQuery) returns (AIJob)

 @handler aiAgentReport
 get /report (AIQuery) returns (AIReport)

 @handler aiAgentStart
 post /run/start (AIWrite) returns (AIRun)

 @handler aiAgentFinish
 post /run/finish (AIWrite) returns (AIRun)

 @handler aiAgentFlag
 post /submission/flag (AIWrite) returns (AIFlagResult)

 @handler aiAgentRuntimeStart
 post /runtime/start (AIWrite) returns (AIRuntime)

 @handler aiAgentRuntimeStop
 post /runtime/stop (AIWrite) returns (AIRuntime)

 @handler aiAgentRuntimeExtend
 post /runtime/extend (AIWrite) returns (AIRuntime)

 @handler aiAgentPatchUpload
 post /patch/upload (AIWrite) returns (AIPatchResult)

 @handler aiAgentPatchSubmit
 post /patch/submit (AIWrite) returns (AIJob)

}
